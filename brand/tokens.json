{
  "$comment": "Single source of truth for LUCID LABS LTD. Mirrors BRAND.md — change here, not in layouts.",
  "themes": {
    "dark": {
      "bg": "#0B0A08",
      "surface": "#12100C",
      "text": "#E8E2D4",
      "muted": "#8A8272",
      "accent": "#FFB000",
      "border": "#2A2620",
      "green": "#3FBF6B"
    },
    "paper": {
      "bg": "#F0EBDD",
      "surface": "#E9E3D2",
      "text": "#26221A",
      "muted": "#6E675A",
      "accent": "#9A5B00",
      "border": "#D5CDB8",
      "green": "#1E7A45"
    }
  },
  "font": {
    "family": "JetBrains Mono",
    "fallback": "IBM Plex Mono, ui-monospace, monospace",
    "file": "JetBrainsMono",
    "weights": {
      "regular": 400,
      "medium": 500,
      "bold": 700,
      "extrabold": 800
    }
  },
  "tracking": {
    "headline": 0.012,
    "label": 0.14,
    "wordmark": 0.1,
    "body": 0
  },
  "layout": {
    "padRatio": 0.05,
    "radiusRatio": 0.006,
    "safeAreaRatio": 0.05
  },
  "rules": {
    "amberMaxPct": 10,
    "greenAllowedOnlyFor": "BUILT chips and online/status dots",
    "uppercaseHeadlines": true,
    "name": "LUCID LABS LTD"
  },
  "sizes": {
    "16x9": { "width": 1600, "height": 900 },
    "4x5": { "width": 1080, "height": 1350 },
    "1x1": { "width": 1080, "height": 1080 },
    "1920x1080": { "width": 1920, "height": 1080 },
    "1080x1920": { "width": 1080, "height": 1920 }
  }
}
